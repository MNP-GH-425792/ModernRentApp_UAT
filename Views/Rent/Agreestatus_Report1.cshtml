        function bindAgreementTable(data) {

            if (!data || data.length == 0) {
                $("#tblAgreementReport").html("");
                return;
            }

            var categoryId = sessionStorage.getItem("AgreementCategoryId");
            var statusId = sessionStorage.getItem("AgreementStatusId");

            var html = "<thead><tr>";

            if (categoryId == "1") {
                html += "<th>BRANCH</th>";
                html += "<th>CUSTOMER_ID</th>";
            }
            else if (categoryId == "11") {
                html += "<th>OFFICE-SPACE</th>";
                html += "<th>ENTER_DATE</th>";
            }
            else {
                html += "<th>FLAT-NAME</th>";

                if (statusId == "4")
                    html += "<th>ENTER_DATE</th>";
                else if (statusId == "6")
                    html += "<th>AREA</th>";
                else
                    html += "<th>ACC_APPROVE_DT</th>";
            }

            html += "<th>OWNER</th>";
            html += "<th>SECURITY DEP.</th>";
            html += "<th>TOT_RENT</th>";
            html += "<th>PERIOD</th>";

            if (categoryId == "1")
                html += "<th>SQUARE FEET</th>";
            else
                html += "<th>CAPACITY</th>";

            if (statusId == "6") {
                html += "<th>ADVANCE TAKEN DATE</th>";
                html += "<th>PENDING DAYS</th>";
            }
            else if (statusId == "5") {
                html += "<th></th>";
                html += "<th>PENDING DAYS</th>";
            }
            else {
                html += "<th></th>";
                html += "<th></th>";
            }

            html += "</tr></thead><tbody>";

            var totalCount = 0;
            var totalSecurityDeposit = 0;
            var totalRent = 0;

            $.each(data, function (i, item) {


                html += "<tr>";

                       if (categoryId == "1") {

            html += "<td>" + (item.BRANCH_OFFICE_SPACE || "") + "</td>";
            html += "<td>" + (item.CUSTOMER_ID || "") + "</td>";
        }
        else if (categoryId == "11") {

            html += "<td>" + (item.BRANCH_OFFICE_SPACE || "") + "</td>";

            if (
                item.ENTERED_DATE == null ||
                item.ENTERED_DATE == "" ||
                item.ENTERED_DATE == "[object Object]" ||
                typeof item.ENTERED_DATE === "object"
            ) {
                html += "<td>NOT ENTERED</td>";
            }
            else {
                html += "<td>" + item.ENTERED_DATE + "</td>";
            }
        }
        else {

            html += "<td>" + (item.FLAT_NAME || "") + "</td>";

            if (statusId == "4") {

                if (
                    item.ENTER_DATE == null ||
                    item.ENTER_DATE == "" ||
                    item.ENTER_DATE == "[object Object]" ||
                    typeof item.ENTER_DATE === "object"
                ) {
                    html += "<td>NOT ENTERED</td>";
                }
                else {
                    html += "<td>" + item.ENTER_DATE + "</td>";
                }
            }
            else if (statusId == "6") {

                html += "<td>" + (item.AREA || "") + "</td>";
            }
            else {

                if (
                    item.ACC_APPROVE_DT == null ||
                    item.ACC_APPROVE_DT == "" ||
                    item.ACC_APPROVE_DT == "[object Object]" ||
                    typeof item.ACC_APPROVE_DT === "object"
                ) {
                    html += "<td>NOT ENTERED</td>";
                }
                else {
                    html += "<td>" + item.ACC_APPROVE_DT + "</td>";
                }
            }
        }
        

                html += "<td>" + (item.OWNER_NAME || "") + "</td>";

                html += "<td style='text-align:right'>" +
                    Number(item.SECURITY_DEPOSIT || 0).toLocaleString('en-IN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }) +
                    "</td>";

                html += "<td style='text-align:right'>" +
                    Number(item.TOTAL_RENT || 0).toLocaleString('en-IN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }) +
                    "</td>";

                html += "<td>" + (item.RENT_PERIOD || "") + "</td>";

                if (categoryId == "1")
                    html += "<td>" + (item.SQFEET_CAPACITY || "") + "</td>";
                else
                    html += "<td>" + (item.CAPACITY || item.SQFEET_CAPACITY || "") + "</td>";

                if (statusId == "6") {

                    html += "<td>" + (item.ADVANCE_TAKEN_DATE || "") + "</td>";
                    html += "<td>" + (item.PENDING_DAYS || "") + "</td>";
                }
                else if (statusId == "5") {

                    html += "<td></td>";
                    html += "<td>" + (item.PENDING_DAYS || "") + "</td>";
                }
                else {

                    html += "<td></td>";
                    html += "<td></td>";
                }

                totalCount++;
                totalSecurityDeposit += Number(item.SECURITY_DEPOSIT || 0);
                totalRent += Number(item.TOTAL_RENT || 0);

                html += "</tr>";
            });

            html += "<tr style='background:#eef5fb;color:#8B0000;font-weight:bold;'>";

            html += "<td>TOTAL :</td>";
            html += "<td>" + totalCount + "</td>";
            html += "<td></td>";

            html += "<td style='text-align:right'>" +
                totalSecurityDeposit.toLocaleString('en-IN', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }) +
                "</td>";

            html += "<td style='text-align:right'>" +
                totalRent.toLocaleString('en-IN', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }) +
                "</td>";

            html += "<td></td>";
            html += "<td></td>";

            if (statusId == "5" || statusId == "6") {
                html += "<td></td>";
                html += "<td></td>";
            }

            html += "</tr>";

            html += "</tbody>";

            $("#tblAgreementReport").html(html);
        }

