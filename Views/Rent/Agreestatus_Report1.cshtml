        function ExportToExcel() {

            var wb = XLSX.utils.book_new();

            var branchId = $("#spBranchId").text();
            var branchName = $("#spBranchName").text();
            var date = $("#spDate").text();
            var time = $("#spTime").text();
            var heading = $("#spReportHeading").text();

            var wsData = [];

            // Report Header
            wsData.push(["MANAPPURAM FINANCE LIMITED"]);
            wsData.push([]);
            wsData.push(["Branch Id", branchId]);
            wsData.push(["Branch Name", branchName]);
            wsData.push(["Date", date]);
            wsData.push(["Time", time]);
            wsData.push([]);
            wsData.push([heading]);
            wsData.push([]);

            // Table Headers
            var table = document.getElementById("tblAgreementReport");

            $(table).find("thead tr").each(function () {
                var row = [];
                $(this).find("th").each(function () {
                    row.push($(this).text().trim());
                });
                wsData.push(row);
            });

            // Table Data
            $(table).find("tbody tr").each(function () {
                var row = [];
                $(this).find("td").each(function () {
                    row.push($(this).text().trim());
                });
                wsData.push(row);
            });

            var ws = XLSX.utils.aoa_to_sheet(wsData);

            // Merge Company Name
            ws["!merges"] = [
                {
                    s: { r: 0, c: 0 },
                    e: { r: 0, c: 8 }
                },
                {
                    s: { r: 7, c: 0 },
                    e: { r: 7, c: 8 }
                }
            ];

            // Auto Width
            ws["!cols"] = [
                { wch: 20 }, { wch: 25 }, { wch: 20 }, { wch: 20 },
                { wch: 15 }, { wch: 15 }, { wch: 20 }, { wch: 15 }, { wch: 15 }
            ];

            XLSX.utils.book_append_sheet(wb, ws, "Agreement Report");

            XLSX.writeFile(wb, "Agreement_Report.xlsx");
        }

        function Exit1() {

            window.location.href = "/ModernRentApp/Rent/Index";
            // window.location.href = "/MebsCustomerApp/Customer/Index";
        }

