@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor httpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/css/index.css">
       <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="~/js/rentcustomerpanupdate.js"></script>

    <style>
        body {
            background: #f4f6f9;
        }

        .pagecontiner {
            background: #ffffff;
            padding: 40px;
            border-radius: 20px;
        }

        .page-header {
            text-align: center;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 20px;
        }
        /* Page Background */
        body {
            background: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Main Container */
        .rent-pan-section {
            max-width: 900px;
            margin: 40px auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        /* Header */
        .title {
            background: linear-gradient(135deg, #b71c1c, #d32f2f);
            color: #fff;
            text-align: center;
            padding: 18px;
            font-size: 20px;
            font-weight: 600;
            letter-spacing: .5px;
        }

        /* Form Area */
        .rent-pan-section .row {
            display: flex;
            gap: 20px;
            padding: 15px 25px 0;
        }

        .field-group {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .full-width {
            width: 100%;
        }

        /* Labels */
        .field-group label {
            color: #374151;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        /* Inputs & Dropdowns */
        .form-control {
            width: 100%;
            height: 42px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 0 12px;
            font-size: 14px;
            background: #fff;
            transition: all .3s ease;
        }

            .form-control:focus {
                border-color: #d32f2f;
                box-shadow: 0 0 0 3px rgba(211,47,47,.15);
                outline: none;
            }

        select.form-control {
            cursor: pointer;
        }

        input[readonly] {
            background: #f8f9fa;
        }

        .button-section {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            padding: 20px 25px;
            border-top: 1px solid #e5e7eb;
            margin-top: 20px;
        }

        .btn-confirm,
        .btn-exit {
            min-width: 140px;
            height: 42px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all .25s ease;
        }

        .btn-confirm {
            background: #198754;
            color: #fff;
            box-shadow: 0 3px 8px rgba(25,135,84,.25);
        }

            .btn-confirm:hover {
                background: #157347;
                transform: translateY(-2px);
            }

        .btn-exit {
            background: #dc3545;
            color: #fff;
            box-shadow: 0 3px 8px rgba(220,53,69,.25);
        }

            .btn-exit:hover {
                background: #bb2d3b;
                transform: translateY(-2px);
            }
    </style>
</head>

<body>

    <script>var rootValue = '@ViewData["root"]';</script>

    <div class="pagecontiner">

        <div class="page-header">
            <i class='bx bx-id-card'></i>
            RENT CUSTOMER PAN CARD UPDATION
        </div>

        <div class="rent-pan-section">

            
            <div class="row">

                <div class="field-group">
                    <label>Select Category</label>
                    <select id="ddlCategory" class="form-control" onchange="branchLoad()"></select>
                </div>

                <div class="field-group">
                    <label>Select Branch</label>
                    <select id="ddlBranch" class="form-control" onchange="loadBuilding()"></select>
                </div>

            </div>

            <div class="row">

                <div class="field-group">
                    <label>Select Building</label>
                    <select id="ddlBuilding" class="form-control" onchange="loadCustomer()"></select>
                </div>

                <div class="field-group">
                    <label>Select Customer</label>
                    <select id="ddlCustomer" class="form-control" onchange="loadDetails()"></select>
                </div>

            </div>

            <div class="row">

                <div class="field-group full-width">
                    <label>Address</label>
                    <input type="text" id="txtAddress" class="form-control" readonly />
                </div>

            </div>

            <div class="row">

                <div class="field-group">
                    <label>Phone Number</label>
                    <input type="text" id="txtPhoneNumber" class="form-control" readonly />
                </div>

                <div class="field-group">
                    <label>PAN Number</label>
                    <input type="text" id="txtPanNumber" class="form-control" maxlength="20" />
                </div>

            </div>

            <div class="button-section">
                <button id="btnConfirm" type="button" class="btn-confirm" onclick="confirm()">
                    <i class='bx bx-check-circle' ></i>
                    Confirm
                </button>

                <button id="btnExit" type="button" class="btn-exit" onclick="exit()">
                    <i class='bx bx-x-circle' ></i>
                    Exit
                </button>
            </div>

        </div>
</div>
    <input type="hidden" id="LUserName" value="@ViewData["EmpName"]" />

    <input type="hidden" id="LUserId" value="@ViewData["EmpCode"]" />
    <input type="hidden" id="LBranchId" value="@ViewData["BrID"]" /> 

</body>
</html>